{
  "name": "xunjian-desktop",
  "version": "50.4.1",
  "description": "巡检缺陷命名分类工具桌面版",
  "author": "Xunjian Desktop",
  "private": true,
  "main": "app/main.cjs",
  "scripts": {
    "start": "electron .",
    "check": "node scripts/check.cjs",
    "test:unit": "node --test tests/unit/*.test.cjs",
    "test:ui": "playwright test",
    "test": "npm run check && npm run test:unit && npm run test:ui",
    "dist:win": "electron-builder --win nsis --x64 --publish never",
    "test:installed": "node scripts/test-installed.cjs",
    "dist:win:linux": "node scripts/build-from-linux.cjs"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "acorn": "8.15.0",
    "electron": "45.5.0",
    "electron-builder": "26.18.0",
    "jpeg-js": "0.4.4",
    "pngjs": "7.0.0",
    "resedit": "3.0.2"
  },
  "build": {
    "appId": "local.xunjian.desktop",
    "productName": "巡检缺陷工具",
    "asar": true,
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "app/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "app/icon.ico",
      "artifactName": "Xunjian-Wuhu-Setup-${version}-${arch}.${ext}",
      "signExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "deleteAppDataOnUninstall": false,
      "createDesktopShortcut": true,
      "shortcutName": "巡检缺陷工具",
      "installerIcon": "app/icon.ico",
      "uninstallerIcon": "app/icon.ico",
      "include": "build/installer.nsh",
      "createStartMenuShortcut": true
    },
    "npmRebuild": false
  },
  "dependencies": {
    "docx": "^9.16.0",
    "exifr": "^7.1.3",
    "xlsx": "^0.18.5"
  }
}
